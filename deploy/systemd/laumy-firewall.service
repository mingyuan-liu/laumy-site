[Unit]
Description=Restrict direct access to private laumy service ports
DefaultDependencies=no
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -p tcp --dport 8360 ! -i lo -j DROP 2>/dev/null || /usr/sbin/iptables -A INPUT -p tcp --dport 8360 ! -i lo -j DROP'
ExecStart=/bin/sh -c '/usr/sbin/ip6tables -C INPUT -p tcp --dport 8360 ! -i lo -j DROP 2>/dev/null || /usr/sbin/ip6tables -A INPUT -p tcp --dport 8360 ! -i lo -j DROP'
ExecStop=/bin/sh -c '/usr/sbin/iptables -D INPUT -p tcp --dport 8360 ! -i lo -j DROP 2>/dev/null || true'
ExecStop=/bin/sh -c '/usr/sbin/ip6tables -D INPUT -p tcp --dport 8360 ! -i lo -j DROP 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
